# Salin file ini menjadi ".env" lalu isi nilainya

# Token dari akun Fonnte (Menu > Device kamu > Token), untuk mengirim balasan otomatis
FONNTE_TOKEN=isi_token_fonnte_disini

# Kata sandi bebas untuk mengunci endpoint edit manual di dashboard
ADMIN_TOKEN=buat_kata_sandi_admin_disini

# Port server (biarkan default kalau tidak yakin)
PORT=3000

# Nominal iuran default kalau nominal tidak disebut di pesan
DEFAULT_AMOUNT=25000

# Isi "1" jika ingin server membalas otomatis ke pengirim setelah pesan berhasil dicatat
AUTO_REPLY=1

# ---- Penagihan otomatis (opsional) ----
# Isi "1" untuk mengaktifkan jadwal penagihan otomatis ke anggota yang belum bayar
REMINDER_ENABLED=0

# Bulan yang ditagih oleh jadwal otomatis, harus sama persis dengan salah satu
# nilai di "months" pada members.json. Ganti setiap bulan berjalan.
REMINDER_MONTH=JULI

# Jadwal dalam format cron (menit jam tanggal bulan hari). Contoh di bawah
# artinya: tiap tanggal 25, jam 09:00 pagi.
REMINDER_CRON=0 9 25 * *

# Jangan kirim ulang penagihan ke anggota yang sama dalam N jam terakhir,
# supaya tidak dianggap spam kalau tombol kirim manual dipakai berkali-kali
REMINDER_COOLDOWN_HOURS=20

# Boleh dikosongkan untuk pakai template bawaan. Placeholder yang tersedia:
# {nama} {nama_lengkap} {bulan} {nominal}
REMINDER_TEMPLATE=

# ---- Rekap PDF otomatis (opsional) ----
# Biasanya tidak perlu diisi — server menebak alamatnya sendiri dari
# request yang masuk. Isi manual hanya kalau rekap gagal terkirim karena
# server tidak bisa menentukan alamat publiknya sendiri.
BASE_URL=

# ---- Wajib foto bukti transfer ----
# Isi "0" untuk MEMATIKAN kewajiban ini (anggota boleh bayar cukup dengan
# teks saja, tanpa foto). Default "1" / wajib.
WAJIB_BUKTI_TRANSFER=1

# Ke mana foto bukti transfer disimpan di server. PENTING: baca bagian
# "Bukti transfer" di README soal penyimpanan permanen di Railway.
UPLOAD_DIR=./uploads
